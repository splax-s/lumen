# Copy to .env and adjust. Nothing here is a real secret.
# These match docker-compose.yml. With scripts/dev-services.sh instead, use
# postgresql+asyncpg://lumen@127.0.0.1:5433/lumen_dev and redis://127.0.0.1:6380/0
DATABASE_URL=postgresql+asyncpg://lumen:lumen@localhost:5432/lumen
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_HOURS=336
STAFF_SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false

# Lumi, the AI tutor. LUMI_PROVIDER is one of: anthropic, openai_compatible, none.
# With "none", or with no key, Lumi answers from the scripted lines in each lesson.
LUMI_PROVIDER=none
LUMI_MODEL=claude-opus-5-5
LUMI_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

TUTOR_RETENTION_DAYS=90
LESSONS_DIST=../../packages/lessons/dist
# Development only: treat every account as having this plan (free, family or school).
DEV_PLAN_OVERRIDE=
